STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:7000,http://localhost:9000,https://docs.medusajs.com
VENDOR_CORS=http://localhost:7000,https://docs.medusajs.com
# REDIS_URL=redis://localhost:6379 - only enable if having redis running locally
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=postgres://postgres:postgres@localhost/mercurjs
# Set false only for a trusted local/private PostgreSQL server without TLS.
# DATABASE_SSL=false
MEDUSA_ADMIN_EMAIL=admin@yourmail.com
MEDUSA_ADMIN_PASSWORD=supersecret

# Algolia Configuration (Optional - enables automatic index creation and product syncing)
# ALGOLIA_APP_ID=your-application-id
# ALGOLIA_API_KEY=your-admin-api-key

# S3-compatible storage (required in production)
# Railway mappings:
# S3_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
# S3_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
# S3_BUCKET=${{Bucket.BUCKET}}
# S3_ENDPOINT=${{Bucket.ENDPOINT}}
# S3_REGION=${{Bucket.REGION}}
# S3_FILE_URL=https://${{Bucket-proxy.RAILWAY_PUBLIC_DOMAIN}}
S3_FILE_URL=http://localhost:9001/medusa-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=medusa-media
S3_ENDPOINT=http://localhost:9001
S3_FORCE_PATH_STYLE=true
S3_ACL=false

# Existing deployments may keep a complete MINIO_* contract temporarily.
# Never mix MINIO_* and S3_* variables.
# MINIO_ENDPOINT=minio.example.com
# MINIO_ACCESS_KEY=your-access-key
# MINIO_SECRET_KEY=your-secret-key
# MINIO_BUCKET=medusa-media

# Stripe Connect (optional; Medusa's system payment provider is used when empty)
# STRIPE_SECRET_API_KEY=sk_test_your_secret_key_here
# Required with STRIPE_SECRET_API_KEY to enable Stripe checkout payments.
# STRIPE_WEBHOOK_SECRET=whsec_your_checkout_webhook_secret_here
# Required to receive Stripe connected-account payout webhooks when using Stripe.
# STRIPE_CONNECTED_ACCOUNTS_WEBHOOK_SECRET=whsec_your_connect_webhook_secret_here
